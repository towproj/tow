#!/bin/sh
# Blocks commits whose staged changes contain secrets (cloud keys, tokens, private keys).
# Enable once per clone with: make hooks

if ! command -v gitleaks >/dev/null 2>&1; then
	echo "pre-commit: gitleaks is not installed, so staged changes can't be scanned for secrets." >&2
	echo "Install it: https://github.com/gitleaks/gitleaks#installing" >&2
	exit 1
fi

exec gitleaks git --pre-commit --staged --redact --verbose
